# Solver and optimization outputs. Every run writes a fresh XDMF/HDF5 series;
# none of it belongs in the repository.
solver_outputs/
control_outputs/
baseline_outputs/
*.xdmf
*.h5
optimal_control.npy
optimization_history.json
forward_summary.json

# Mesh-generation products. Regenerate them with
# generate_mesh_and_attributes.py rather than committing them; see
# README_mesh_generation.md.
*.msh
*.mesh
*.vtk
land_cover_classes.npy
land_cover_diffusivity.npy
coord_offsets.npy
effective_parameters.json
susceptible_equilibrium.npy
susceptible_equilibrium.json

# Source rasters: DEM and NLCD downloads are large and are not redistributed.
*.tif
*.tiff
*.tif.aux.xml

__pycache__/
*.py[cod]

# The one bundle that IS kept, so the solvers can be run without first
# building a mesh. This must stay last: in .gitignore the final matching
# rule wins, so the negations have to follow every pattern above.
#
# Listed file by file on purpose. The mesher's intermediates in that folder
# (terrain_input.vtk, terrain_remeshed.mesh) stay ignored: nothing downstream
# reads them and together they are ~5 MB. The two susceptible_equilibrium
# entries do not exist until the first solver run caches them there.
!example_mesh_output/terrain.msh
!example_mesh_output/land_cover_classes.npy
!example_mesh_output/land_cover_diffusivity.npy
!example_mesh_output/coord_offsets.npy
!example_mesh_output/effective_parameters.json
!example_mesh_output/susceptible_equilibrium.npy
!example_mesh_output/susceptible_equilibrium.json
