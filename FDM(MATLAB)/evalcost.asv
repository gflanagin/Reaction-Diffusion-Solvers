function cost = evalcost(S,E,I,R,V,u,dM,d,mu,beta,Nt, Nx, Ny,dt,dx,dy,c1,c2,c3)


cost = .5*dt*(I + c1*sigma*E + c2*squeeze(u(1,:,:)));
for t=1:Nt
    ut = squeeze(u(t,:,:));
    b = bf(t*dt);

    S1 = dM \ reshape(S + dt*(b*(S+E+R) - d*S - beta*S.*I - (V./(V+k)).*S), Nx*Ny,1);
    E1 = dM \ reshape(S + dt*(beta*S.*I - (sigma + d)*E), Nx*Ny, 1);
    I1 = dM \ reshape(I + dt*(sigma*rho*E - mu*I), Nx*Ny,1);
    R1 = dM \ reshape(R + dt*(sigma*(1-rho)*E - d*R + (V./(V+k)).*S), Nx*Ny,1);
    V1 = V + dt*(ut - V.*(gamma_1*(S+E+R) + gamma_2*I + delta));

    S = reshape(S1,Nx,Ny);
    E = reshape(E1,Nx,Ny);
    I = reshape(I1,Nx,Ny);
    R = reshape(R1,Nx,Ny);
    V = V1;
    
    if t==Nt
        cost = cost + .5*dt*(I + c1*sigma*E + c2*squeeze(u(t+1,:,:)));
    else
        cost = cost + dt*(I + c1*sigma*E + c2*squeeze(u(t+1,:,:)));
    end
end

cost = (dx/2)*(squeeze(cost(1,:)) + 2*sum(cost(2:Nx-1,:)) + squeeze(cost(Nx,:)));
cost = (dy/2)*(cost(1) + 2*sum(cost(2:Ny-1)) + cost(Ny));

termcost = (dx/2)(I)

end